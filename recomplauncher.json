{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Super Stardust Ultra VR",
  "repo": "rcostanza/super-stardust-ultra-vr-recomp",
  "game": {
    "kind": "folder",
    "label": "Your decrypted dump of Super Stardust Ultra VR for PS4 (CUSA05951, version 1.00, no update): the folder with eboot.bin, sce_module, sce_sys and stream.dat.",
    "check": { "file": "SD3_bank00.fev" }
  },
  "start": {
    "program": ["stardust.exe", "stardust"]
  },
  "prepare": {
    "program": ["stardust-setup.exe", "stardust-setup"],
    "args": ["--game", "{game}", "--progress"],
    "label": "Preparing the game from your dump",
    "timeout": 600,
    "options": [
      {
        "id": "accept_untested",
        "label": "Set up a dump other than the tested one",
        "note": "Only CUSA05951 1.00 was tested: another dump may crash or show bugs.",
        "args": ["--accept-untested"],
        "default": false
      }
    ],
    "done": ["{install}/paths.ini", "{install}/game/release.txt"]
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [
        { "path": "{install}/save/settings.ini", "if": "{install}/save/settings.ini" },
        { "path": "{install}/settings.ini" }
      ]
    }
  ],
  "saves": ["{install}/save/savedata", "{install}/save/trophies.dat", "{install}/save/settings.ini"],
  "folders": {
    "saves": [{ "path": "{install}/save" }],
    "logs": [{ "path": "{install}/save/log" }],
    "install": [{ "path": "{install}" }]
  },
  "settings": [
    {
      "id": "display_mode",
      "label": "Window",
      "help": "Borderless covers the screen at the desktop's resolution. Fullscreen takes the screen for itself. Windowed uses Window size.",
      "choices": [
        { "label": "Borderless", "set": { "display_mode": "borderless" } },
        { "label": "Fullscreen", "set": { "display_mode": "fullscreen" } },
        { "label": "Windowed", "set": { "display_mode": "windowed" } }
      ],
      "defaults": { "display_mode": "borderless" }
    },
    {
      "id": "output_resolution",
      "label": "Window size",
      "help": "The window's size in Windowed mode. The game draws 16:9.",
      "choices": [
        { "label": "1280 x 720", "set": { "output_resolution": "1280x720" } },
        { "label": "1600 x 900", "set": { "output_resolution": "1600x900" } },
        { "label": "1920 x 1080", "set": { "output_resolution": "1920x1080" } },
        { "label": "2560 x 1440", "set": { "output_resolution": "2560x1440" } },
        { "label": "3840 x 2160", "set": { "output_resolution": "3840x2160" } }
      ],
      "defaults": { "output_resolution": "1920x1080", "display_mode": "borderless" },
      "when": { "display_mode": "windowed" }
    },
    {
      "id": "render_resolution",
      "label": "Render resolution",
      "help": "The size the game itself draws at, HUD and menus included. 1080p is the PS4's; 1440p and 4K are sharper and need a faster graphics card.",
      "choices": [
        { "label": "720p", "set": { "render_resolution": "720p" } },
        { "label": "1080p", "set": { "render_resolution": "1080p" } },
        { "label": "1440p", "set": { "render_resolution": "1440p" } },
        { "label": "4K", "set": { "render_resolution": "4k" } }
      ],
      "defaults": { "render_resolution": "1080p" }
    },
    {
      "id": "frame_rate",
      "label": "Frame rate",
      "help": "At normal game speed: 60 is the PS4's. The game runs fixed steps, so a PC that can't hold the rate makes it run slower; 30 is for slower PCs.",
      "choices": [
        { "label": "30", "set": { "frame_rate": "30" } },
        { "label": "60", "set": { "frame_rate": "60" } },
        { "label": "90", "set": { "frame_rate": "90" } },
        { "label": "120", "set": { "frame_rate": "120" } },
        { "label": "144", "set": { "frame_rate": "144" } },
        { "label": "180", "set": { "frame_rate": "180" } }
      ],
      "defaults": { "frame_rate": "60" }
    },
    {
      "id": "vsync",
      "label": "V-Sync",
      "help": "On waits for the screen: no tearing. Off shows the newest frame at each refresh. Tearing shows every frame at once, for the least delay and frame rates above the screen's.",
      "choices": [
        { "label": "On", "set": { "vsync": "1" } },
        { "label": "Off", "set": { "vsync": "0", "tearing": "0" } },
        { "label": "Off, tearing", "set": { "vsync": "0", "tearing": "1" } }
      ],
      "defaults": { "vsync": "1", "tearing": "0" }
    },
    {
      "id": "sharpening",
      "label": "Sharpening",
      "help": "AMD FSR 1 sharpening: crisper edges at almost no cost. F9 switches it while you play.",
      "choices": [
        { "label": "On", "set": { "sharpening": "1" } },
        { "label": "Off", "set": { "sharpening": "0" } }
      ],
      "defaults": { "sharpening": "1" }
    },
    {
      "id": "audio_channels",
      "label": "Speakers",
      "help": "Automatic follows your sound device.",
      "choices": [
        { "label": "Automatic", "set": { "audio_channels": "auto" } },
        { "label": "Stereo", "set": { "audio_channels": "stereo" } },
        { "label": "5.1", "set": { "audio_channels": "5.1" } },
        { "label": "7.1", "set": { "audio_channels": "7.1" } }
      ],
      "defaults": { "audio_channels": "auto" }
    },
    {
      "id": "pad_speaker",
      "label": "Controller speaker",
      "help": "A DualShock 4 or DualSense plugged in by USB plays the game's controller sounds on its own speaker; otherwise they play on your speakers.",
      "choices": [
        { "label": "Controller", "set": { "pad_speaker": "controller" } },
        { "label": "Main speakers", "set": { "pad_speaker": "main" } },
        { "label": "Off", "set": { "pad_speaker": "off" } }
      ],
      "defaults": { "pad_speaker": "controller" }
    },
    {
      "id": "skip_intro",
      "label": "Intro",
      "help": "Skip goes straight to the main menu in about 10 seconds.",
      "choices": [
        { "label": "Skip", "set": { "skip_intro": "1" } },
        { "label": "Show", "set": { "skip_intro": "0" } }
      ],
      "defaults": { "skip_intro": "1" }
    }
  ],
  "actions": [
    { "id": "saves", "label": "Saves", "help": "Your saves, settings, trophies and logs.", "open": "saves" },
    { "id": "shader_cache", "label": "Shader cache", "help": "Shaders the game has built, so it doesn't stutter later. Clearing only helps if graphics look wrong after an update.", "clear": "install/shaders" }
  ]
}
